    HITL1_check -->|rejected| END_hitl

    N3c --> N3d --> HITL2_check
    HITL2_check -->|approved| N4
    HITL2_check -->|rejected| N3c

    N4 --> N4b --> N5 --> N5_check
    N5_check -->|"success"| N5b
    N5_check -->|"fail < 3 retries"| N4
    N5_check -->|"fail ≥ 3 retries"| END_exec

    N5b --> N5b_check
    N5b_check -->|"pass"| N6
    N5b_check -->|">50% weak/unsupported"| END_nopaper

    N6 --> N6b --> Panel
    AgA & AgB & AgC --> Debate --> N8 --> N6r

    N6r --> N9 --> N9_check
